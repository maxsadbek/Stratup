# FuelGo Frontend Environment

# API (set VITE_USE_MOCK_DATA=false when backend is ready)
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_USE_MOCK_DATA=true
VITE_DEMO_MODE=true

# App
VITE_APP_NAME=FuelGo
VITE_APP_TAGLINE=Smart fuel discovery for Uzbekistan

# Default map center (Tashkent)
VITE_DEFAULT_LAT=41.2995
VITE_DEFAULT_LNG=69.2401
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Optional: Google Maps
VITE_GOOGLE_MAPS_API_KEY=

# Feature flags (future)
VITE_ENABLE_DELIVERY=false
VITE_ENABLE_FLEET_API=false
